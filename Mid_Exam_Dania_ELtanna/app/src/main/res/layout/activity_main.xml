<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:background="@color/artwork_background">

    <TextView
        android:id="@+id/artworkCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 6"
        android:textSize="16sp"
        android:textColor="@color/artwork_text"
        android:layout_marginBottom="16dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:background="@color/artwork_card"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/artworkImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:contentDescription="Artwork image" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginTop="16dp"
        android:background="@color/artwork_info">

        <TextView
            android:id="@+id/artworkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artwork title"
            android:textSize="20sp"
            android:textColor="@color/artwork_text" />

        <TextView
            android:id="@+id/artworkArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artist name (year)"
            android:textSize="12sp"
            android:textColor="@color/artwork_secondary_text"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/previousButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Previous"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:backgroundTint="@color/button_brown"
            android:enabled="false" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:backgroundTint="@color/button_brown" />
    </LinearLayout>

</LinearLayout>